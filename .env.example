# SQLite 数据库路径（相对当前工作目录）
DATABASE_URL=./db/monitor.db

# 监控结果保留天数（每24小时自动清理一次过期结果）
RESULT_RETENTION_DAYS=30

# 日志级别：trace/debug/info/warn/error（支持按模块覆盖，如 info,hyper=warn）
# 每次检查的结果日志为 debug 级别，失败为 warn；缺省 info 时只显示失败与关键事件
RUST_LOG=info

# 管理员凭证：配置口令后启用登录认证（强烈建议配置后再暴露到网络）
# 不配置任何口令时 API 与控制台处于无认证状态（启动日志会有明确WARN）
ADMIN_USER=admin
#
# 口令支持两种方式（口令 KDF 已升级为 argon2id，ADR-0006）：
#   1) 【推荐】ADMIN_PASSWORD_HASH：预先生成的 argon2 PHC 字符串（形如 $argon2id$v=19$...），
#      明文口令不进环境变量/进程表。可用任意 argon2 工具生成，例如：
#        - Linux: 用 argon2 CLI： echo -n '你的口令' | argon2 "$(openssl rand -base64 16)" -id -e
#        - 或用本项目依赖的 argon2 crate 写个一次性小程序输出 PHC 字符串
#   2) 【兼容】ADMIN_PASSWORD：明文口令，进程启动时用随机盐派生一次 argon2 摘要（仅驻内存）。
#      两者同时配置时以 ADMIN_PASSWORD_HASH 优先。
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...（示例，请替换为真实摘要）
# ADMIN_PASSWORD=your-strong-password

# Prometheus抓取令牌（可选）：配置后 /metrics 需要 Authorization: Bearer <token>
# METRICS_TOKEN=random-token-for-prometheus

# 会话cookie Secure标志（可选）：
#   缺省行为按 BIND_ADDR 推断——非本机监听（如 0.0.0.0 / 公网）默认开启 Secure，
#   本机(127.0.0.1/localhost)默认关闭，便于本地 HTTP 调试。
#   如需覆盖默认：COOKIE_SECURE=1 强制开启，COOKIE_SECURE=0 强制关闭。
#   注意：开启 Secure 后浏览器仅在 HTTPS 下回传该 cookie；纯 HTTP 访问会导致登录态丢失。
# COOKIE_SECURE=1

# 信任反向代理（可选，ADR-0006 E4）：仅当本服务部署在可信反向代理（Nginx/网关）之后时开启。
#   TRUST_PROXY=1 时，登录限流的客户端 IP 取 X-Forwarded-For 最左侧地址；
#   缺省(关闭)时取 TCP 直连对端 IP。
#   警告：若未经可信代理而直接暴露却开启此项，攻击者可伪造 XFF 绕过按 IP 的登录限流，切勿开启。
# TRUST_PROXY=1

# Web API监听地址（可选）：缺省127.0.0.1仅本机访问；容器/局域网部署设0.0.0.0
# BIND_ADDR=0.0.0.0

# 日志目录与CSV路径（可选）：容器部署应指向持久卷，避免容器重建丢失
# LOG_DIR=./logs
# CSV_PATH=./monitor_log.csv
